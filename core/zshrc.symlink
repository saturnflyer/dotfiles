#! /bin/sh

for module in $(cat ~/.modules); do
    module_init_path=$HOME/dotfiles/$module/init.sh
    if [[ -e $module_init_path ]]; then
	. $module_init_path
    fi
    PATH=$PATH:$HOME/dotfiles/$module/bin
done

ssh-add --apple-load-keychain

eval "$(/opt/homebrew/bin/brew shellenv)"
# source $HOMEBREW_PREFIX/opt/chruby/share/chruby/chruby.sh
# source $HOMEBREW_PREFIX/opt/chruby/share/chruby/auto.sh

export PATH="./bin:/usr/local/sbin:$PATH"

export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Add pg_config
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

export PATH="/opt/homebrew/opt/python/libexec/bin:$PATH"
export PATH="/opt/homebrew/opt/bison/bin:$PATH"
export PATH="/opt/homebrew/opt/openssl@3/bin:$PATH"
export PATH="/opt/homebrew/opt/sqlite/bin:$PATH"
export PATH="/opt/homebrew/opt/libxml2/bin:$PATH"

export PATH="$HOME/.local/bin:$PATH"

stty icrnl

export EDITOR=mate
export LESS="-x2 -eFRX"

export TERM=xterm-256color

number_of_cores=`sysctl -n hw.ncpu`
alias bundle-speed="bundle config --global jobs `expr $number_of_cores - 1`"

unsetopt nomatch

if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh/site-functions:$FPATH
fi

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Created by newuser for 5.7.1
# Lines configured by zsh-newuser-install
HISTFILE=~/.zsh_history
HISTSIZE=1000
SAVEHIST=1000
bindkey -e
# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename "$HOME/.zshrc"

autoload -Uz compinit
compinit
# End of lines added by compinstall

# Load version control information
autoload -Uz vcs_info
precmd() { vcs_info }

bundle-search(){
  ag "$1" $(bundle show --paths)
}

# Format the vcs_info_msg_0_ variable
zstyle ':vcs_info:git:*' formats 'on branch %b'

# Set up the prompt (with git branch name)
setopt PROMPT_SUBST
PROMPT='%n in ${PWD/#$HOME/~} ${vcs_info_msg_0_} > '

source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

[[ -e ~/.bash_profile ]] && emulate sh -c 'source ~/.bash_profile'

export PATH="$HOME/rubyonmac:$PATH"


# qlty completions
[ -s "/opt/homebrew/share/zsh/site-functions/_qlty" ] && source "/opt/homebrew/share/zsh/site-functions/_qlty"

# qlty
export QLTY_INSTALL="$HOME/.qlty"
export PATH="$QLTY_INSTALL/bin:$PATH"

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
# End of LM Studio CLI section


if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Added by Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# GitHub Packages credentials for Bundler (SOFware private gems)
if command -v gh >/dev/null 2>&1; then
  __gh_pkg_token="$(gh auth token 2>/dev/null)"
  [ -n "$__gh_pkg_token" ] && \
    export BUNDLE_RUBYGEMS__PKG__GITHUB__COM="saturnflyer:$__gh_pkg_token"
  unset __gh_pkg_token
fi

# Added by Antigravity IDE
export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# Go binaries (go install)
export PATH="$HOME/go/bin:$PATH"

# Machine-specific customization. Keep this last so it can rely on
# everything above (mise, compinit) and override it.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
